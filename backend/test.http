@baseUrl = http://localhost:3000

### Health check
GET {{baseUrl}}/health

### Get all products
GET {{baseUrl}}/api/products

### Get product by valid ID
GET {{baseUrl}}/api/products/1

### Get product by invalid ID
GET {{baseUrl}}/api/products/999

### Create product
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "sku": "P003",
  "name": "Pencil",
  "price": 5,
  "stockQty": 300
}

### Create product with missing field
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "sku": "P004",
  "price": 20,
  "stockQty": 50
}

### Create product with duplicate SKU
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "sku": "P001",
  "name": "Duplicate Notebook",
  "price": 60,
  "stockQty": 25
}

##################################################
# CUSTOMER API TESTS
##################################################

### Create Customer
POST {{baseUrl}}/api/customers
Content-Type: application/json

{
  "code": "C003",
  "name": "ABC Stores",
  "phone": "9876543210",
  "email": "accounts@abcstores.com"
}

### List Customers
GET {{baseUrl}}/api/customers

### Get Customer By ID
GET {{baseUrl}}/api/customers/1

### Get Invalid Customer ID
GET {{baseUrl}}/api/customers/999

### Create Duplicate Customer Code
POST {{baseUrl}}/api/customers
Content-Type: application/json

{
  "code": "C001",
  "name": "Duplicate Customer"
}

### Create Customer With Missing Name
POST {{baseUrl}}/api/customers
Content-Type: application/json

{
  "code": "C002"
}

### Create Another Customer
POST {{baseUrl}}/api/customers
Content-Type: application/json

{
  "code": "C002",
  "name": "XYZ Traders",
  "phone": "9123456780",
  "email": "contact@xyztraders.com"
}

### Update Customer
PATCH {{baseUrl}}/api/customers/1
Content-Type: application/json

{
  "code": "C001",
  "name": "ABC Stores Updated",
  "phone": "9876543210",
  "email": "admin@abcstores.com"
}

### Delete Customer
DELETE {{baseUrl}}/api/customers/1

### Verify Customer Is Not In Active List
GET {{baseUrl}}/api/customers

